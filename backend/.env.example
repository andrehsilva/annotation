# Config local do NotAI. Fora do git (`.env` está no .gitignore).
# Copie para `.env` e preencha — o BFF e `tools/appwrite_schema.py` leem daqui.

# --- Appwrite (instância da VPS, 1.8.1; SDK Python pinado em requirements.txt) ---
APPWRITE_ENDPOINT=https://appwrite.sacadaweb.com.br/v1
APPWRITE_PROJECT_ID=6ab6f7580005cfa8b079
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=6ab6f84a000192f6d39d
APPWRITE_MEDIA_BUCKET_ID=media

# --- Caminhos locais (o padrão já é backend/data) ---
# CADERNO_DATA_DIR=backend/data
# CADERNO_ADMIN_EMAIL=andrehrsilva@gmail.com
# CADERNO_ADMIN_PASSWORD=

# --- Produção ---
# Obrigatório atrás de HTTPS: sem isto o cookie de sessão viaja sem `Secure`. Em desenvolvimento
# (http://localhost) deixe desligado, senão o navegador não devolve o cookie.
CADERNO_COOKIE_SECURE=1
# Origens extras aceitas em CORS e como exceção do guard de escrita. Em produção o SPA é
# same-origin, então fica vazio; só preencha se servir o front de outro host.
# CADERNO_ALLOWED_ORIGINS=https://outro.exemplo
